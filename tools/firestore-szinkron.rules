rules_version = '2';
// MAGYAH – Firestore-szabályok a profil-szinkronhoz.
// Minden dokumentum titkosított; az azonosító a szinkronkódból származik.
// Listázni nem lehet, így kód nélkül a dokumentum meg sem található.
service cloud.firestore {
  match /databases/{database}/documents {
    match /magyah/{docId} {
      function isMain() { return docId.matches('^[0-9a-f]{40}$'); }
      function isPart() { return docId.matches('^[0-9a-f]{40}_[0-9a-z]{16}_[0-9]{1,3}$'); }
      function okMain() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'rev', 'iv', 'z', 'data', 'by', 'at'])
          && d.v is int && d.rev is int && d.iv is string && d.z is bool && d.by is string
          && d.data is string && d.data.size() < 1000000
          && d.at == request.time;
      }
      function okPart() {
        let d = request.resource.data;
        return d.keys().hasOnly(['v', 'iv', 'z', 'n', 'data'])
          && d.v is int && d.data is string && d.data.size() < 1000000;
      }
      allow get: if isMain() || isPart();
      allow create: if (isMain() && okMain() && request.resource.data.rev == 1) || (isPart() && okPart());
      allow update: if (isMain() && okMain() && request.resource.data.rev == resource.data.rev + 1) || (isPart() && okPart());
      allow delete: if isPart();
      allow list: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
