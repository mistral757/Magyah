{
  "rules": {
    ".read": false,
    ".write": false,

    "mp": {
      "ping": {
        ".read": true
      },
      "rooms": {
        "$code": {
          ".read": "$code.length === 4",
          ".write": "$code.length === 4",
          "code":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length === 4)" },
          "mode":      { ".validate": "newData.isString() && newData.val().length <= 24" },
          "status":    { ".validate": "newData.isString() && newData.val().length <= 24" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "seed":      { ".validate": "newData.isString() && newData.val().length <= 64" },
          "players": {
            "$pid": {
              ".validate": "$pid.length <= 40",
              "role":  { ".validate": "newData.isString() && newData.val().length <= 12" },
              "ready": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          },
          "start": { ".validate": true },
          "h2h":   { ".validate": true }
        }
      }
    },

    "lb": {
      "runs": {
        ".read": true,
        ".indexOn": ["infRun"],
        "$entry": {
          ".write": "auth != null && $entry.beginsWith(auth.uid + '_') && $entry.length <= 96 && (!data.exists() || !newData.exists() || newData.child('at').val() > data.child('at').val() + 10000)",
          ".validate": "newData.hasChildren(['v','nick','pid','infRun','infLevel','infSeasons','at']) && $entry.matches(/^[A-Za-z0-9_-]+$/)",
          "v":          { ".validate": "newData.isNumber() && newData.val() === 1" },
          "nick":       { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20" },
          "pid":        { ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 24" },
          "infRun":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "infLevel":   { ".validate": "newData.isNumber() && newData.val() >= 60 && newData.val() <= 400" },
          "infSeasons": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
          "team":       { ".validate": "newData.isString() && newData.val().length <= 40" },
          "titles":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
          "ballons":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
          "at":         { ".validate": "newData.isNumber() && newData.val() <= now + 120000 && newData.val() > now - 86400000" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
